check_every: 300
# retries: 0

notifiers:
  - type: "console"
    colorize: true
  - type: "prometheus"
    metrics_path: "/metrics"
    listen: 0.0.0.0
    port: 8080
  - type: "telegram"
    # name: MyBot
    token: BOT_TOKEN
    chat_id: CHAT_ID (mostly bot id)

checks:
  - type: "http"
    # retries: nil (defaults to main config's `retries` above)
    url: https://www.facebook.com
    match_body: Facebook
    ssl_min_days_valid: 7 # default

    # method: "GET" # "POST" | "GET" | ...

    # body: nil
    # OR
    # body: '{"some":"payload"}'
    # body:
    #   key: "value"
    #   key2: "value2"

    # headers:
    #   Content-Type: "application/x-www-form-urlencoded"

    # dns_timeout: 10
    # connect_timeout: 120
    # read_timeout: 120

  - type: "host_ip"
    host: www.google.com
    port: 80
  - type: "host_ip"
    host: www.google.com
    port: 443
    ssl_min_days_valid: 7 # default
  - type: "http"
    url: https://google.com
    status_code: 302
  - type: "ftp"
    host: ftp.example.com
    # port: 21

    # How TLS is negotiated:
    #   "explicit" - connect in the clear, then AUTH TLS (RFC 4217), port 21
    #   "implicit" - TLS from the first byte, conventionally port 990
    #   "none"     - plain FTP
    # tls: "explicit"

    # Log in as well, instead of stopping after the greeting/handshake.
    # user: "alice"
    # password: "s3cret"

    # match_banner: "Pure-FTPd"

    # Set to false for a server with a self-signed certificate. Expiry is
    # still checked, the chain is not.
    # ssl_verify: true
    # ssl_min_days_valid: 7 # default, null disables

    # connect_timeout: 10
    # read_timeout: 10
